TELEGRAM_BOT_TOKEN=your_token_here

# Leave blank for local polling. Render supplies RENDER_EXTERNAL_URL automatically.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET_TOKEN=

# Optional settings
MAX_DOWNLOADS_PER_HOUR=10
MAX_CONCURRENT_DOWNLOADS=3
ADMIN_TELEGRAM_ID=
# Legacy Pro settings are unused; ReelDrop is completely free.
PRO_PRICE_STARS=0
PRO_DURATION_DAYS=0
# Download-count limits are disabled. These legacy values should remain 0.
FREE_DAILY_LIMIT=0
PRO_DAILY_SOFT_LIMIT=0
MAX_TELEGRAM_FILE_SIZE_MB=49
TEMP_FILE_MAX_AGE_HOURS=24
